// Program Operations Dashboard - Educational Outreach, IIT Bombay
// Entities follow the "Minimum Suggested Entities" table in the assignment,
// with the optional normalised `payments` table included.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProgramMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum ProgramStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

enum PaymentTxnStatus {
  SUCCESS
  FAILED
  REFUNDED
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  is_system   Boolean          @default(false) // seeded roles: rename/delete blocked
  users       User[]
  permissions RolePermission[]
  created_at  DateTime         @default(now())

  @@map("roles")
}

model Permission {
  id     Int              @id @default(autoincrement())
  key    String           @unique // e.g. "programs.delete"
  label  String
  module String // grouping for the UI matrix
  roles  RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id       Int
  permission_id Int
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String // bcrypt hash - never returned by any API
  role_id   Int
  role      Role      @relation(fields: [role_id], references: [id])
  is_active Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  programs  Program[] @relation("ProgramCreatedBy")

  @@index([role_id])
  @@map("users")
}

model Program {
  id            Int            @id @default(autoincrement())
  name          String
  code          String         @unique
  mode          ProgramMode    @default(ONLINE)
  start_date    DateTime       @db.Date
  end_date      DateTime       @db.Date
  fee           Decimal        @db.Decimal(10, 2)
  coordinator   String
  status        ProgramStatus  @default(DRAFT)
  created_by    Int
  createdBy     User           @relation("ProgramCreatedBy", fields: [created_by], references: [id])
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  registrations Registration[]

  @@index([status])
  @@index([start_date])
  @@map("programs")
}

model Registration {
  id                  Int                @id @default(autoincrement())
  program_id          Int
  program             Program            @relation(fields: [program_id], references: [id])
  learner_name        String
  learner_email       String
  phone               String
  registration_status RegistrationStatus @default(PENDING)
  payment_status      PaymentStatus      @default(PENDING)
  amount              Decimal            @db.Decimal(10, 2)
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
  payments            Payment[]

  @@index([program_id])
  @@index([registration_status])
  @@index([payment_status])
  @@map("registrations")
}

model Payment {
  id              Int              @id @default(autoincrement())
  registration_id Int
  registration    Registration     @relation(fields: [registration_id], references: [id], onDelete: Cascade)
  amount          Decimal          @db.Decimal(10, 2)
  reference_no    String           @unique
  paid_on         DateTime
  status          PaymentTxnStatus @default(SUCCESS)
  created_at      DateTime         @default(now())

  @@index([registration_id])
  @@map("payments")
}
